# Copie para .env.local e preencha. Nunca commite o .env.local.
#
# Supabase local: rode `npx supabase@2 start` e copie os valores de
# `npx supabase@2 status` (API URL e service_role key).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
# Chave secreta: ignora o RLS. Só o servidor usa, nunca vai para o navegador.
SUPABASE_SERVICE_ROLE_KEY=
